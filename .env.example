# Copy this file to .env and fill in only the values you use.
# Never commit the real .env file.

GOOGLE_API_KEY=
# Optional override; defaults to gemini-3.5-flash-lite in config.py.
MODEL=

# Optional Langfuse tracing. Leave both keys blank to disable remote tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
# Keep off for real user data. Enable only with synthetic data or consent.
TRACE_CONTENT=false
